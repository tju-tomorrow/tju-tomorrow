name: GitHub Profile Stats

on:
  schedule:
    - cron: "0 0 * * *"
  workflow_dispatch:

jobs:
  update-readme:
    name: Update README with stats
    runs-on: ubuntu-latest
    permissions: # 明确指定权限
      contents: write
      actions: write
      
    steps:
      - uses: actions/checkout@v3
      
      - name: Update README
        uses: jamesgeorge007/github-activity-readme@master
        env:
          GITHUB_TOKEN: ${{ secrets.GH_TOKEN }}
          
      - name: Generate stats image
        uses: anmol098/waka-readme-stats@master
        with:
          GITHUB_TOKEN: ${{ secrets.GH_TOKEN }} # 使用默认的 GITHUB_TOKEN
          WAKATIME_API_KEY: ${{ secrets.WAKATIME_API_KEY }} # 如果使用 WakaTime
          SHOW_SHORT_INFO: "True"
          SHOW_PROFILE_VIEWS: "True"
          SHOW_COMMIT: "True"
          SHOW_DAYS_OF_WEEK: "True"
          SHOW_LANGUAGE: "True"
          SHOW_PROJECTS: "True"
          SHOW_LINES_OF_CODE: "True"
